# Optional local frontend-development overrides.
# Installed production builds use the API and Studio URLs compiled into the app.
NEXT_PUBLIC_ENVIRONMENT="local"
NEXT_PUBLIC_GRAPHQL_API_URL="https://localhost:5001/v1/graphql"
NEXT_PUBLIC_STUDIO_WEB_URL="http://localhost:3000"

# Local dev only (self-signed certs)
NODE_TLS_REJECT_UNAUTHORIZED=0

# Background dataset-sync development overrides.
# Path relative to LeRobot home (normally ~/.cache/huggingface/lerobot).
# Absolute paths are also supported.
VULCAN_STUDIO_DATASET_ROOT="vulcan-studio"

# Sourccey backend used to authenticate and issue short-lived Spaces upload URLs.
# Dataset bytes upload directly to DigitalOcean Spaces, not through this server.
VULCAN_DATASET_SYNC_API_BASE_URL="https://localhost:5001"

# Build-time only (required for signed updater artifacts)
TAURI_SIGNING_PUBLIC_KEY=
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
