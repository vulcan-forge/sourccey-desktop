# Frontend/public build-time config
NEXT_PUBLIC_ENVIRONMENT="local"
NEXT_PUBLIC_REST_API_URL="https://localhost:5001/v1"

# Local dev only (self-signed certs)
NODE_TLS_REJECT_UNAUTHORIZED=0

# Build-time only (required for signed updater artifacts)
TAURI_SIGNING_PUBLIC_KEY=
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# macOS customer builds (Developer ID Application identity)
APPLE_SIGNING_IDENTITY=

# Preferred notarization credentials: App Store Connect API key
APPLE_API_ISSUER=
APPLE_API_KEY=
APPLE_API_KEY_PATH=
